# ─── Campus Canteen Backend — Environment Template ──────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/campus_canteen

# JWT secrets — use long random strings in production
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRE=1d
JWT_REFRESH_EXPIRE=7d

# Nodemailer (Gmail example) — used for password-reset OTP emails
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Frontend origin (CORS + socket)
CLIENT_URL=http://localhost:5173

# ─── Cashfree Payment Gateway (Sandbox first — never use real money) ──
# Get test credentials from the Cashfree dashboard (Sandbox mode):
# https://merchant.cashfree.com/devstudio/home → API Keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# SANDBOX or PRODUCTION
CASHFREE_ENVIRONMENT=SANDBOX
# Optional: where Cashfree redirects after payment (defaults to <CLIENT_URL>/student/payment-status)
CASHFREE_RETURN_URL=
# Optional: public webhook URL configured in the Cashfree dashboard
# (e.g. https://your-ngrok-domain.ngrok-free.app/api/payments/webhook)
CASHFREE_WEBHOOK_URL=
